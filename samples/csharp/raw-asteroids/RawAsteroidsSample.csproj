<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>Panda3D.RawAsteroids.AsteroidsGame</StartupObject>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Panda3D.Interop" Version="1.11.0-preview.*" />
    <PackageReference Include="Panda3D.Runtime.linux-x64" Version="1.11.0-preview.*" />
    <PackageReference Include="Panda3D.Runtime.osx-arm64" Version="1.11.0-preview.*" />
    <PackageReference Include="Panda3D.Runtime.osx-x64" Version="1.11.0-preview.*" />
    <PackageReference Include="Panda3D.Runtime.win-x64" Version="1.11.0-preview.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="etc/*.prc" CopyToOutputDirectory="PreserveNewest" LinkBase="etc" />
    <Content Include="../../asteroids/models/**" CopyToOutputDirectory="PreserveNewest" LinkBase="asteroids/models" />
    <Content Include="../../asteroids/textures/**" CopyToOutputDirectory="PreserveNewest" LinkBase="asteroids/textures" />
  </ItemGroup>

</Project>
