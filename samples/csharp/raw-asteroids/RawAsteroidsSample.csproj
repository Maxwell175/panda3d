<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>Panda3D.RawAsteroids.AsteroidsGame</StartupObject>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Panda3D" Version="1.11.0-preview.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="etc/*.prc" CopyToOutputDirectory="PreserveNewest" LinkBase="etc" />
  </ItemGroup>

</Project>
