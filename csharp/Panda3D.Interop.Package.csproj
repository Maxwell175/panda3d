<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Panda3D.Interop</PackageId>
    <Version>1.11.0</Version>
    <Authors>Panda3D</Authors>
    <Description>C# bindings for the Panda3D game engine. Ships two API variants selected by the consumer's build optimization: Debug (the full surface, including debug-feature methods like collision recording/PStats — resolves against a Standard runtime, for development/JIT) and Release (the lean, NativeAOT-safe surface). A Release/optimized build compiles against the lean surface, so AOT-incompatible calls fail to compile before PublishAot is ever enabled. Override with -p:Panda3DInteropConfiguration=Debug|Release.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/panda3d/panda3d</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- The variant assemblies live under variants/ and are referenced by the shipped
         targets, not the lib/ convention — so these "no lib/" warnings are expected. -->
    <NoWarn>$(NoWarn);NU5100;NU5127;NU5128</NoWarn>

    <InterrogateCoreVersion Condition="'$(InterrogateCoreVersion)' == ''">*</InterrogateCoreVersion>

    <!-- Prebuilt variant assemblies (built from Panda3D.Interop.csproj against the Standard
         and Release binding sources). CI sets both; locally a single build serves both. -->
    <DebugInteropDll Condition="'$(DebugInteropDll)' == ''">bin/Release/net8.0/Panda3D.Interop.dll</DebugInteropDll>
    <ReleaseInteropDll Condition="'$(ReleaseInteropDll)' == ''">$(DebugInteropDll)</ReleaseInteropDll>
  </PropertyGroup>

  <!-- The variant assemblies reference Interrogate.Core, so the package depends on it. -->
  <ItemGroup>
    <PackageReference Include="Interrogate.Core" Version="$(InterrogateCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(DebugInteropDll)" Pack="true" PackagePath="variants/Debug/Panda3D.Interop.dll" />
    <None Include="$(ReleaseInteropDll)" Pack="true" PackagePath="variants/Release/Panda3D.Interop.dll" />
    <!-- The selector (Reference to the right variant) + the PRC writer it imports. -->
    <None Include="Panda3D.Interop.Variants.targets" Pack="true" PackagePath="buildTransitive/net8.0/Panda3D.Interop.targets" />
    <None Include="Panda3D.NuGet.targets" Pack="true" PackagePath="buildTransitive/net8.0/Panda3D.Interop.Prc.targets" />
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
