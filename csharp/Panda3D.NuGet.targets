<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Generate etc/20_panda.prc in the build output with default display/loader config.
       Plugin-path is left at the default (<auto>) which searches the directory
       containing p3dtool.dll — that is the same runtimes/{rid}/native/ dir where
       all native libs live. -->
  <Target Name="_Panda3DCopyPrcConfig" AfterTargets="Build">
    <PropertyGroup>
      <_P3EffectiveRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_P3EffectiveRid>
      <_P3EffectiveRid Condition="'$(_P3EffectiveRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_P3EffectiveRid>
    </PropertyGroup>

    <ItemGroup Condition="'$(_P3EffectiveRid)' != ''">
      <_P3PrcLines Include="load-display pandagl" />
      <_P3PrcLines Include="aux-display p3tinydisplay" />
      <_P3PrcLines Include="load-file-type egg pandaegg" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)etc" Condition="'$(_P3EffectiveRid)' != ''" />
    <WriteLinesToFile
      File="$(OutDir)etc/20_panda.prc"
      Lines="@(_P3PrcLines)"
      Overwrite="true"
      Condition="'$(_P3EffectiveRid)' != ''" />
  </Target>

  <!-- Copy PRC config into the publish directory for deployed/AOT binaries. -->
  <Target Name="_Panda3DCopyPrcToPublish" AfterTargets="_Panda3DCopyPrcConfig"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_P3PrcPublish Include="$(OutDir)etc/*.prc" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)etc" Condition="@(_P3PrcPublish) != ''" />
    <Copy SourceFiles="@(_P3PrcPublish)"
          DestinationFolder="$(PublishDir)etc"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
